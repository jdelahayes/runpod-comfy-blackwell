# Copier en .env puis compléter. Lu par tous les scripts deploy/*.py.
RUNPOD_API_KEY=

# Image publiée par ../runpod-comfy (voir build.sh / push.sh)
IMAGE="ghcr.io/<ton-user>/runpod-comfy-blackwell:latest"

# Chaîne exacte vérifiée via `runpodctl gpu list -o json` (le nom "court" ne suffit pas).
# Il existe aussi une variante "Workstation Edition", beaucoup moins disponible (1 seul
# datacenter au moment de la vérification, contre 10 pour la "Server Edition" ci-dessous) ;
# les deux sont la même puce (Blackwell, sm_120, 96 Go) donc ça ne change rien pour nos images.
GPU_ID="NVIDIA RTX PRO 6000 Blackwell Server Edition"

DATA_CENTER_ID="US-KS-2"
POD_NAME="comfy-minimax-h3"
CONTAINER_DISK_GB=30

# Rempli automatiquement par 01-create-volume.py, ou renseigne l'ID d'un volume existant.
VOLUME_ID=
VOLUME_SIZE_GB=250
VOLUME_MOUNT_PATH="/runpod-volume"

# Rempli automatiquement par 02-start-pod.py
POD_ID=

# Profils d'utilisation à installer au démarrage du pod (modèles, custom nodes, workflows,
# paquets pip — voir la section Profils du README). Seul ce qui manque est téléchargé : le
# premier démarrage sur un volume vide est long, les suivants sont rapides. Plusieurs profils
# séparés par des virgules, ex: "minimax-h3-all,flux2-klein-9b". Vide = rien installé au démarrage.
# Liste complète : ./07-sync-profiles.py list (une fois le pod créé), ou scripts/profiles.json.
COMFY_PROFILES="minimax-h3-all"

# Fichier de profils utilisé par le pod. Vide = celui embarqué dans l'image
# (/opt/scripts/profiles.json). Pour le personnaliser sans rebuild, pointer vers le volume,
# ex: "/runpod-volume/config/profiles.json" : s'il n'existe pas encore, la config de l'image y
# est copiée au démarrage, à éditer ensuite (via JupyterLab par exemple).
COMFY_PROFILES_CONFIG=

# Les trois tokens ci-dessous ne sont jamais passés en clair au pod ni au template :
# 10-create-or-update-secrets.py les pousse dans les secrets RunPod hf_token, civitai_token et
# jupyter_token, référencés ensuite via {{ RUNPOD_SECRET_<nom> }}.

# Token Hugging Face (https://huggingface.co/settings/tokens). Nécessaire si un des
# dépôts de modèles devient "gated"/privé, et évite le rate-limit anonyme sur les gros
# téléchargements. Utilisé par scripts/comfy_profiles.py (lu automatiquement par
# huggingface_hub via cette variable d'environnement).
HF_TOKEN=

# Token CivitAI (https://civitai.com/user/account -> API Keys). Utilisé par les éléments de
# profil de source "civitai" (aucun dans les profils fournis, tous sur Hugging Face).
CIVITAI_TOKEN=

# Token d'accès à JupyterLab (port 8888, exposé publiquement comme ComfyUI). Si le secret
# jupyter_token est vide, un token aléatoire est généré à chaque démarrage du pod (visible
# dans ses logs, via ./06-ssh.py) ; fixe une valeur ici pour un accès stable entre redémarrages.
JUPYTER_TOKEN=

# Nom du template RunPod (créé/mis à jour par 09-create-or-update-template.py). Un template
# reprend les mêmes réglages qu'un `pod create` direct, réutilisable depuis le dashboard RunPod
# ou via `runpodctl pod create --template-id ...`.
TEMPLATE_NAME="comfy-minimax-h3"

# Rempli automatiquement par 09-create-or-update-template.py.
TEMPLATE_ID=
