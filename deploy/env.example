# Copier en .env puis compléter, puis: set -a; source deploy/.env; set +a
RUNPOD_API_KEY=

# Image publiée par ../runpod-comfy (voir build.sh / push.sh)
IMAGE="ghcr.io/<ton-user>/runpod-comfy-blackwell:latest"

# Chaîne exacte vérifiée via `runpodctl gpu list -o json` (le nom "court" ne suffit pas).
# Il existe aussi une variante "Workstation Edition", beaucoup moins disponible (1 seul
# datacenter au moment de la vérification, contre 10 pour la "Server Edition" ci-dessous) ;
# les deux sont la même puce (Blackwell, sm_120, 96 Go) donc ça ne change rien pour nos images.
GPU_ID="NVIDIA RTX PRO 6000 Blackwell Server Edition"

DATA_CENTER_ID="US-KS-2"
POD_NAME="comfy-minimax-h3"
CONTAINER_DISK_GB=30

# Rempli automatiquement par 01-create-volume.sh, ou renseigne l'ID d'un volume existant.
VOLUME_ID=
VOLUME_SIZE_GB=250
VOLUME_MOUNT_PATH="/runpod-volume"

# Rempli automatiquement par 02-start-pod.sh
POD_ID=

# 1 = télécharge automatiquement les modèles manquants au démarrage du pod (plus lent
# au premier boot). 0 = utiliser deploy/07-download-models.sh une fois pour peupler
# le volume, puis laisser à 0 pour des démarrages rapides ensuite.
MODELS_AUTO_DOWNLOAD=0

# Tag(s) à télécharger (voir scripts/models.json ; liste complète via
# `./07-download-models.sh --list` une fois le pod créé). Plusieurs tags séparés par des
# virgules, ex: "turbo,compact". Tags fournis par défaut :
#   turbo   : base FL2VA/Ref2VA non-pruned + LoRA turbo (LightX2V) — rendu rapide, 4-8 steps.
#             Fonctionne tel quel avec le workflow ComfyUI par défaut.
#   hq      : la même base, sans LoRA — rendu qualité max, plus lent, tous les steps.
#   compact : variante pruned (un peu plus légère) + LoRA HyperFlow — nécessite un sampler
#             custom (Euler/normal + sigmas manuels), voir scripts/models.json.
MODEL_TAGS="turbo"

# Les trois tokens ci-dessous ne sont jamais passés en clair au pod ni au template :
# 10-create-or-update-secrets.sh les pousse dans les secrets RunPod hf_token, civitai_token et
# jupyter_token, référencés ensuite via {{ RUNPOD_SECRET_<nom> }}.

# Token Hugging Face (https://huggingface.co/settings/tokens). Nécessaire si un des
# dépôts de modèles devient "gated"/privé, et évite le rate-limit anonyme sur les gros
# téléchargements. Utilisé par scripts/download_models.py (lu automatiquement par
# huggingface_hub via cette variable d'environnement).
HF_TOKEN=

# Token CivitAI (https://civitai.com/user/account -> API Keys). Pas encore utilisé par
# les scripts actuels (tous les modèles viennent de Hugging Face), mais câblé et
# propagé au pod en prévision d'un futur script de téléchargement CivitAI.
CIVITAI_TOKEN=

# Token d'accès à JupyterLab (port 8888, exposé publiquement comme ComfyUI). Si le secret
# jupyter_token est vide, un token aléatoire est généré à chaque démarrage du pod (visible
# dans ses logs, via ./06-ssh.sh) ; fixe une valeur ici pour un accès stable entre redémarrages.
JUPYTER_TOKEN=

# Nom du template RunPod (créé/mis à jour par 09-create-or-update-template.sh). Un template
# reprend les mêmes réglages qu'un `pod create` direct, réutilisable depuis le dashboard RunPod
# ou via `runpodctl pod create --template-id ...`.
TEMPLATE_NAME="comfy-minimax-h3"

# Rempli automatiquement par 09-create-or-update-template.sh.
TEMPLATE_ID=
