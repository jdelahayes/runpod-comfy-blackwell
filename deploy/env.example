# Copier en .env puis compléter, puis: set -a; source deploy/.env; set +a
RUNPOD_API_KEY=

# Image publiée par ../runpod-comfy (voir build.sh / push.sh)
IMAGE="ghcr.io/<ton-user>/runpod-comfy-blackwell:latest"

# Voir `runpodctl gpu list` pour la chaîne exacte disponible sur ton compte.
GPU_ID="NVIDIA RTX PRO 6000"

DATA_CENTER_ID="US-KS-2"
POD_NAME="comfy-minimax-h3"
CONTAINER_DISK_GB=30

# Rempli automatiquement par 01-create-volume.sh, ou renseigne l'ID d'un volume existant.
VOLUME_ID=
VOLUME_SIZE_GB=250
VOLUME_MOUNT_PATH="/runpod-volume"

# Rempli automatiquement par 02-start-pod.sh
POD_ID=

# 1 = télécharge automatiquement les modèles manquants au démarrage du pod (plus lent
# au premier boot). 0 = utiliser deploy/07-download-models.sh une fois pour peupler
# le volume, puis laisser à 0 pour des démarrages rapides ensuite.
MODELS_AUTO_DOWNLOAD=0
DOWNLOAD_FULL_QUALITY=0
